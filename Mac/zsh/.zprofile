# =============================================================================
# 登录 shell 环境（GUI / 非交互场景也能拿到 Homebrew PATH）
# 必须在这里而非 .zshenv：macOS 的 /etc/zprofile 会跑 path_helper 重排 PATH
# 交互配置仍在 .zshrc
# =============================================================================

source "${${(%):-%N}:A:h}/config/path.zsh"
